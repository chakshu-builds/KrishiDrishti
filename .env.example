# KrishakDrishti Environment Configuration

# Server Ports
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Database & Authentication (Supabase PostgreSQL)
# When SUPABASE_URL is provided, backend connects to Supabase PostgreSQL.
# In local development mode without credentials, a resilient in-memory SQLite parity store is used.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=crop-field-media

# AI Service (Google Gemini API - @google/genai)
# Used for multimodal crop pathology diagnostics and conversational multilingual assistance
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mandi & Agricultural Market Intelligence
# Optional API key if using Govt of India data.gov.in / Agmarknet API; built-in official APMC feed fallback provided
AGMARKNET_API_KEY=your_agmarknet_api_key
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key

# Weather Service
# Open-Meteo is free & keyless; optional OpenWeatherMap / IMD API key
WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=your_openweather_key

# Telephony & Voice Hotline (IVR / Twilio / Exotel)
# Set credentials for live voice hotline; an interactive development sandbox simulator is included
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
HOTLINE_FALLBACK_SMS=true

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=krishak_drishti_verify_token

# IoT & Hardware Telemetry
IOT_INGESTION_SECRET=krishak_iot_secret_key_2026
IOT_SIMULATOR_ENABLED=true
