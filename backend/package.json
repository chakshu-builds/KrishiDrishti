{
  "name": "krishak-drishti-backend",
  "version": "1.0.0",
  "description": "KrishakDrishti Shared Agricultural Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "test:unit": "tsx --test src/tests/api.test.ts src/tests/gemini.test.ts",
    "test:gemini": "tsx --test src/tests/gemini.test.ts",
    "test:integration": "tsx --test src/tests/integration.test.ts",
    "test:crop": "tsx --test src/tests/cropHealthVerification.test.ts",
    "test:workflow": "tsx --test src/tests/workflow.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
