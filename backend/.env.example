# KrishakDrishti Backend Environment Configuration
PORT=5000
FRONTEND_PORT=3000

# Database & Authentication (Supabase PostgreSQL)
# When unconfigured, backend automatically uses data/krishak_db.json with full parity
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=crop-field-media

# AI Service (Google Gemini API - @google/genai)
# Used for multimodal crop pathology diagnostics and conversational multilingual assistance
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mandi & Commodity Feeds
AGMARKNET_API_KEY=your_agmarknet_api_key
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key

# Weather Service (OpenWeather API / Open-Meteo)
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Telephony IVR Hotline (Twilio / Exotel)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API Webhook
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=krishak_drishti_verify_token

# IoT Hardware & Sensor Ingestion
IOT_INGESTION_SECRET=krishak_iot_secret_key_2026
IOT_SIMULATOR_ENABLED=true
